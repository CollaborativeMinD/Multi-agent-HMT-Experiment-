# Whiz Spades model experiment: credential template #

# LOCAL RUNNER
# Copy this template to .env and fill in that LOCAL copy only.
# Add .env and .env.* to .gitignore, with !.env.example as an exception,
# before adding credentials. Never upload the populated copy to chat or GitHub.
#
# OpenAI Platform project API key
OPENAI_API_KEY=OPEN_API_KEY 

# Anthropic / Claude API key, scoped to the experiment workspace
ANTHROPIC_API_KEY=ANTHROPIC_API_KEY 

# Gemini API key from Google AI Studio
GEMINI_API_KEY=GEMINI_API_KEY 

# OpenRouter API key for the hosted Kimi or Qwen entry
OPENROUTER_API_KEY=OPENROUTER_API_KEY 

# Model IDs will be pinned after access checks; keys alone do not select models.
# No live-run spending authorization or model selection is encoded here.
# Revoke the experiment keys at their providers when live runs are complete.
# Replay must work from sanitized recorded actions without these credentials.
